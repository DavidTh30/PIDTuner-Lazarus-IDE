<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="PID Explainer"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Release" Default="True"/>
      <Item Name="Debug">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="bin\PIDExplainer_dbg"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir);src"/>
            <OtherUnitFiles Value="src;..\src"/>
            <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)-dbg"/>
          </SearchPaths>
          <CodeGeneration>
            <Checks>
              <IOChecks Value="True"/>
              <RangeChecks Value="True"/>
              <OverflowChecks Value="True"/>
            </Checks>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
            </Debugging>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LazOpenGLContext"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="PIDExplainer.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src\uPlatform.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlatform"/>
      </Unit>
      <Unit>
        <Filename Value="src\uDrawKit.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uDrawKit"/>
      </Unit>
      <Unit>
        <Filename Value="src\uSimKit.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uSimKit"/>
      </Unit>
      <Unit>
        <Filename Value="src\uScenarios.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uScenarios"/>
      </Unit>
      <Unit>
        <Filename Value="src\uLessons.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uLessons"/>
      </Unit>
      <Unit>
        <Filename Value="src\uExplainer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uExplainer"/>
      </Unit>
      <Unit>
        <Filename Value="src\uExplainerForm.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uExplainerForm"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\PIDCore.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="PIDCore"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\BGRAView.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="BGRAView"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\PlotViews.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="PlotViews"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\HeatmapView.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="HeatmapView"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\CaptureKit.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="CaptureKit"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin\PIDExplainer"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);src"/>
      <OtherUnitFiles Value="src;..\src"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <SmartLinkUnit Value="True"/>
      <Optimizations>
        <OptimizationLevel Value="3"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <GenerateDebugInfo Value="False"/>
      </Debugging>
      <LinkSmart Value="True"/>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
